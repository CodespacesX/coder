{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "offlinedocs": {
      "root": "offlinedocs",
      "framework": "nextjs",
			"outputDirectory": "build"
    },
    "site": {
      "root": "site",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "site"
      }
    }
  ]
}
